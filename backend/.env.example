# Server Configuration
NODE_ENV=development
PORT=5000

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/industry_chatbot?schema=public

# Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# OpenAI API (Company-Provided)
OPENAI_API_KEY=your-company-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=768

# Optional: Legacy Gemini configuration (for transition if needed)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=text-embedding-004

# Application & CORS
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Crawler Settings
DEFAULT_PROJECT_URL=https://prycoons.com/
CRAWLER_USER_AGENT=BRIM-AI-KnowledgeBot/1.0 (+https://brimai.com/bot)
MAX_CRAWL_PAGES=50

# RAG Pipeline Configuration
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.45
CHUNK_SIZE=500
CHUNK_OVERLAP=80
